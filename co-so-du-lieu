Table ADMINS {
  id integer [pk, increment]
  username varchar(100) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(50) [not null, note: 'super_admin | admin']
  is_active boolean [not null, default: true]
  created_by integer [null]
  created_at datetime [not null]
  updated_at datetime [null]
}

Table DON_VI {
  id integer [pk, increment]
  ten_don_vi varchar(255) [not null, unique, note: 'VD: Công nghệ thông tin, Toán, Sử, ...']
  is_active boolean [not null, default: true]
}

Table USERS {
  ma_cbsv varchar(50) [pk]
  ho_ten varchar(255) [not null]
  don_vi_id integer [null]
  chuc_vu varchar(100)
  so_dien_thoai varchar(20)
  email varchar(255)
  created_at datetime [not null]
  updated_at datetime [null]
}

Table EVENTS {
  id integer [pk, increment]
  ten_su_kien varchar(255) [not null]
  hinh varchar(255)
  mo_ta text
  dia_diem varchar(255)
  ngay_bat_dau datetime [not null]
  ngay_ket_thuc datetime [not null]
  thang integer [not null]
  nam integer [not null]
  thoi_gian_mo_dang_ky datetime [not null]
  thoi_gian_dong_dang_ky datetime [not null]
  trang_thai varchar(50) [not null, default: 'upcoming', note: 'upcoming | ongoing | closed']
  created_by integer [not null]
  created_at datetime [not null]
  updated_by integer [null]
  updated_at datetime [null]
}

Table REGISTRATIONS {
  id integer [pk, increment]
  ma_cbsv varchar(50) [not null]
  event_id integer [not null]
  thoi_gian_dang_ky datetime [not null]

  indexes {
    (ma_cbsv, event_id) [unique]
  }
}

Table CHECKINS {
  id integer [pk, increment]
  ma_cbsv varchar(50) [not null]
  event_id integer [not null]
  thoi_gian_checkin datetime [not null]

  indexes {
    (ma_cbsv, event_id) [unique]
  }
}

Table EMAIL_LOGS {
  id integer [pk, increment]
  ma_cbsv varchar(50) [not null]
  event_id integer [not null]
  email_to varchar(255) [not null]
  trang_thai varchar(20) [not null, note: 'success | failed']
  error_message text [null, note: 'Lưu lý do lỗi nếu failed']
  sent_at datetime [not null]
}

Ref: ADMINS.created_by > ADMINS.id

Ref: USERS.don_vi_id > DON_VI.id

Ref: EVENTS.created_by > ADMINS.id
Ref: EVENTS.updated_by > ADMINS.id

Ref: REGISTRATIONS.ma_cbsv > USERS.ma_cbsv
Ref: REGISTRATIONS.event_id > EVENTS.id

Ref: CHECKINS.ma_cbsv > USERS.ma_cbsv
Ref: CHECKINS.event_id > EVENTS.id

Ref: EMAIL_LOGS.ma_cbsv > USERS.ma_cbsv
Ref: EMAIL_LOGS.event_id > EVENTS.id