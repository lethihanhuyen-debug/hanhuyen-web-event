# Chatbot Gemini (lấy key tại https://aistudio.google.com/apikey -- KHÔNG commit key thật)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=12
CHATBOT_RATE_LIMIT=8 per minute;100 per hour
# Chạy sau IIS/ARR (X-Forwarded-For) thì đặt true để rate limit theo IP thật
CHATBOT_TRUST_PROXY=false
