SECRET_KEY=change-me

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=checkin_event
# Or override all of the above:
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/checkin_event?charset=utf8mb4

# React dev server allowed origin
FRONTEND_ORIGIN=http://localhost:5173

# Default admin account created on first run
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# Mail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_SENDER=your-email@gmail.com
